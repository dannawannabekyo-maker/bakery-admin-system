# ---------------------------------------------------------------------------
# Supabase — copy this file to `.env.local` and fill in real values.
# Project dashboard: https://supabase.com/dashboard/project/_/settings/api
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose to the browser. Used by Admin "God Mode"
# routes (user creation via Admin API, RLS bypass).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
